{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug GoogleTest (Windows)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build (debug-unit-tests)",
      "args": [],
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug GoogleTest (Linux/macOS)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build (debug-unit-tests)",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "linux": {
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb"
      },
      "osx": {
        "MIMode": "lldb"
      }
    }
  ]
}
