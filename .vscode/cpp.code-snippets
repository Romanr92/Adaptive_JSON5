{
  "Header guard": {
    "scope": "cpp",
    "prefix": "hguard",
    "body": [
      "#ifndef ADAPTIVE_JSON5_${TM_FILENAME_BASE/([a-zA-Z0-9]+)|[^a-zA-Z0-9]+/${1:/upcase}${1:+_}/g}H_",
      "#define ADAPTIVE_JSON5_${TM_FILENAME_BASE/([a-zA-Z0-9]+)|[^a-zA-Z0-9]+/${1:/upcase}${1:+_}/g}H_",
      "",
      "$0",
      "",
      "#endif /* ADAPTIVE_JSON5_${TM_FILENAME_BASE/([a-zA-Z0-9]+)|[^a-zA-Z0-9]+/${1:/upcase}${1:+_}/g}H_ */"
    ],
    "description": "Create an Adaptive_JSON5 header guard from the filename"
  }
}
