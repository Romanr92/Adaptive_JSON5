{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure (debug-library)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "debug-library"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build (debug-library)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "debug-library"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc",
        "$msCompile"
      ],
      "dependsOn": "Configure (debug-library)",
      "dependsOrder": "sequence"
    },
    {
      "label": "Configure (release-library)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "release-library"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build (release-library)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "release-library"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc",
        "$msCompile"
      ],
      "dependsOn": "Configure (release-library)",
      "dependsOrder": "sequence"
    },
    {
      "label": "Configure (debug-example)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "debug-example"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build (debug-example)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "debug-example"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc",
        "$msCompile"
      ],
      "dependsOn": "Configure (debug-example)",
      "dependsOrder": "sequence"
    },
    {
      "label": "Configure (debug-unit-tests)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "debug-unit-tests"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build (debug-unit-tests)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "debug-unit-tests"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc",
        "$msCompile"
      ],
      "dependsOn": "Configure (debug-unit-tests)",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Unit tests (debug-unit-tests)",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "debug-unit-tests"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "Build (debug-unit-tests)",
      "dependsOrder": "sequence"
    },
    {
      "label": "Configure (debug-unit-tests-exceptions)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "debug-unit-tests-exceptions"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build (debug-unit-tests-exceptions)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "debug-unit-tests-exceptions"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc",
        "$msCompile"
      ],
      "dependsOn": "Configure (debug-unit-tests-exceptions)",
      "dependsOrder": "sequence"
    },
    {
      "label": "Unit tests (debug-unit-tests-exceptions)",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "debug-unit-tests-exceptions"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "Build (debug-unit-tests-exceptions)",
      "dependsOrder": "sequence"
    },
    {
      "label": "Formatting (check)",
      "type": "process",
      "command": "python",
      "args": [
        "tools/format.py",
        "--check"
      ],
      "linux": {
        "command": "python3"
      },
      "osx": {
        "command": "python3"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Formatting (fix)",
      "type": "process",
      "command": "python",
      "args": [
        "tools/format.py",
        "--fix"
      ],
      "linux": {
        "command": "python3"
      },
      "osx": {
        "command": "python3"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
