# Vendor this helper from a pinned Adaptive_JSON5 revision into a consumer project.
# It imports an existing binary package; it never builds/downloads source dependencies.
include_guard(GLOBAL)

function(adaptive_json5_import_release)
    if(TARGET AdaptiveJSON5::parser)
        message(FATAL_ERROR "AdaptiveJSON5::parser already exists; import the pinned release once, before defining consumers")
    endif()
    cmake_parse_arguments(PARSE_ARGV 0 package ""
        "VERSION;SHA256;PROFILE;CACHE_DIR;ARCHIVE;ROOT" "")
    if(package_UNPARSED_ARGUMENTS OR package_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Unknown or incomplete adaptive_json5_import_release arguments")
    endif()
    if(NOT package_VERSION MATCHES "^v?([0-9]+\\.[0-9]+\\.[0-9]+)(-[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?$")
        message(FATAL_ERROR "VERSION must pin a MAJOR.MINOR.PATCH release (optional v prefix and prerelease)")
    endif()
    set(package_cmake_version "${CMAKE_MATCH_1}")
    if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        message(FATAL_ERROR "Release binaries require GNU G++; use a matching GCC toolchain or build the source package")
    endif()
    separate_arguments(compiler_args NATIVE_COMMAND "${CMAKE_CXX_COMPILER_ARG1}")
    execute_process(COMMAND "${CMAKE_CXX_COMPILER}" ${compiler_args} -dumpmachine
        OUTPUT_VARIABLE triple OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(NOT package_PROFILE)
        if(triple STREQUAL "aarch64-poky-linux")
            set(package_PROFILE adaptivepi-aarch64-yocto5.0.20-sdk0.2.0-gcc)
        elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND triple MATCHES "^x86_64-.*linux")
            set(package_PROFILE linux-x86_64-gcc)
        elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND triple MATCHES "^aarch64-.*linux")
            set(package_PROFILE linux-aarch64-gcc)
        elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows" AND triple MATCHES "^x86_64-.*mingw32$")
            set(package_PROFILE windows-x86_64-mingw-gcc)
        else()
            message(FATAL_ERROR "No binary release profile for ${CMAKE_SYSTEM_NAME}/${triple}; build from source")
        endif()
    endif()
    set(profiles linux-x86_64-gcc linux-aarch64-gcc windows-x86_64-mingw-gcc
        adaptivepi-aarch64-yocto5.0.20-sdk0.2.0-gcc)
    if(NOT package_PROFILE IN_LIST profiles)
        message(FATAL_ERROR "Unsupported AdaptiveJSON5 release profile: ${package_PROFILE}")
    endif()
    set(name "AdaptiveJSON5-${package_VERSION}-${package_PROFILE}")
    if(package_ROOT AND package_ARCHIVE)
        message(FATAL_ERROR "Choose either ROOT or ARCHIVE for offline consumption")
    endif()
    if(package_ROOT)
        get_filename_component(root "${package_ROOT}" ABSOLUTE)
    else()
        string(LENGTH "${package_SHA256}" hash_length)
        if(NOT hash_length EQUAL 64 OR NOT package_SHA256 MATCHES "^[0-9a-fA-F]+$")
            message(FATAL_ERROR "SHA256 must pin the release archive's 64-digit checksum")
        endif()
        string(TOLOWER "${package_SHA256}" package_SHA256)
        if(NOT package_CACHE_DIR)
            set(package_CACHE_DIR "${CMAKE_BINARY_DIR}/_deps/adaptive-json5")
        endif()
        get_filename_component(cache "${package_CACHE_DIR}/${package_SHA256}" ABSOLUTE)
        file(MAKE_DIRECTORY "${cache}")
        file(LOCK "${cache}/package.lock" GUARD FUNCTION TIMEOUT 120)
        set(archive "${cache}/package.tar.gz")
        if(package_ARCHIVE)
            get_filename_component(archive "${package_ARCHIVE}" ABSOLUTE)
        elseif(NOT EXISTS "${archive}")
            set(url "https://github.com/Romanr92/Adaptive_JSON5/releases/download/${package_VERSION}/${name}.tar.gz")
            file(DOWNLOAD "${url}" "${archive}.part"
                EXPECTED_HASH "SHA256=${package_SHA256}" TLS_VERIFY ON
                TIMEOUT 300 INACTIVITY_TIMEOUT 60 STATUS status)
            list(GET status 0 code)
            if(NOT code EQUAL 0)
                file(REMOVE "${archive}.part")
                message(FATAL_ERROR "AdaptiveJSON5 download failed: ${status}; use ARCHIVE or ROOT offline")
            endif()
            file(RENAME "${archive}.part" "${archive}")
        endif()
        if(NOT EXISTS "${archive}")
            message(FATAL_ERROR "AdaptiveJSON5 local archive is missing: ${archive}")
        endif()
        # Verify cached/local bytes on every configure, not only during downloading.
        file(SHA256 "${archive}" actual_hash)
        if(NOT actual_hash STREQUAL package_SHA256)
            message(FATAL_ERROR "AdaptiveJSON5 archive SHA-256 mismatch: ${archive}")
        endif()
        set(root "${cache}/package")
        if(NOT EXISTS "${root}/build-info.json")
            file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${cache}")
            if(NOT EXISTS "${cache}/${name}/build-info.json")
                message(FATAL_ERROR "AdaptiveJSON5 archive layout is invalid")
            endif()
            # Keep compiler include paths short, particularly on Windows.
            file(RENAME "${cache}/${name}" "${root}")
            file(WRITE "${cache}/extracted" "${package_SHA256}\n")
        endif()
    endif()
    # An older cached AdaptiveJSON5_DIR must not redirect this pinned import.
    set(AdaptiveJSON5_DIR "${root}/lib/cmake/AdaptiveJSON5")
    find_package(AdaptiveJSON5 ${package_cmake_version} EXACT REQUIRED CONFIG GLOBAL
        COMPONENTS parser PATHS "${root}/lib/cmake/AdaptiveJSON5"
        NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
    if(NOT AdaptiveJSON5_PACKAGE_PROFILE STREQUAL package_PROFILE)
        message(FATAL_ERROR "AdaptiveJSON5 package profile differs from ${package_PROFILE}")
    endif()
    foreach(variable VERSION SOURCE_REVISION PACKAGE_PROFILE SYSTEM_NAME SYSTEM_PROCESSOR
        COMPILER_ID COMPILER_VERSION TARGET_TRIPLE SDK_SHA256 EXCEPTIONS RTTI)
        set(AdaptiveJSON5_${variable} "${AdaptiveJSON5_${variable}}" PARENT_SCOPE)
    endforeach()
endfunction()
